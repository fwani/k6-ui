# Backend .env 예시 — 복사 후 .env 로 저장
# DATABASE_URL=sqlite:///./app.db
# GRAFANA_DASHBOARD_URL=http://localhost:3001/d/k6-load-testing/k6-load-testing-results
# INFLUXDB_URL=http://influxdb:8086

DATABASE_URL=sqlite:///./app.db
# k6 결과용 기본 대시보드 (Docker: Grafana 포트에 맞게 호스트 주소 사용)
GRAFANA_DASHBOARD_URL=http://localhost:3001/d/k6-load-testing/k6-load-testing-results
INFLUXDB_URL=http://influxdb:8086
# k6 multipart 업로드 저장(기본 backend/data/k6_fixtures). Docker: GRAPHIO_K6_FIXTURE_DIR=/app/data/k6_fixtures
