# 프로젝트 루트 .env 예시 — 로컬/통합 설정 시 사용
# 백엔드: backend/.env 또는 이 파일
# 프론트: frontend/.env 에서 VITE_* 만 사용 (Vite가 자동 로드)

# Backend (backend/app/config.py)
DATABASE_URL=sqlite:///./app.db
# k6 결과용 기본 대시보드 (프로비저닝된 대시보드 고정 URL)
GRAFANA_DASHBOARD_URL=http://localhost:3001/d/k6-load-testing/k6-load-testing-results
INFLUXDB_URL=http://influxdb:8086

# Frontend (frontend: VITE_ 접두사만 노출됨)
VITE_API_URL=http://localhost:8080
